[Unit]
Description=DittoBackTracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ditto
Group=ditto
WorkingDirectory=/var/lib/ditto/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m ditto
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
