[Unit]
Description=DittoBackTracker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ditto-svc
Group=ditto-svc
WorkingDirectory=/var/lib/ditto/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m ditto
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3
# A stop waits for the write in progress (a five-minute track is ~40 s over
# USB) and can retry a 30 s umount, so give it more than the 90 s default
# before systemd escalates to SIGKILL.
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
